{
  "type": "condition.group", "typeVersion": 1, "category": "condition",
  "name": "복합 조건", "description": "여러 측정 항목 조건을 AND·OR로 묶습니다. 항목별 마지막 값으로 판정합니다", "icon": "brackets",
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["items"],
    "properties": {
      "op": {"type": "string", "enum": ["AND", "OR"], "default": "AND"},
      "items": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "required": ["metric", "op"],
        "properties": {"metric": {"type": "string"}, "op": {"type": "string", "enum": [">", ">=", "<", "<=", "==", "!=", "outside", "inside"]},
          "value": {"type": "number"}, "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}},
      "emit": {"type": "string", "enum": ["always", "change"], "default": "always"}
    }
  },
  "inputs": [{"name": "in", "type": "message"}],
  "outputs": [{"name": "true", "type": "message"}, {"name": "false", "type": "message"}, {"name": "error", "type": "error"}],
  "statePolicy": {"op": "KEEP", "items": "RESET", "emit": "KEEP"},
  "permissions": [],
  "defaults": {"retry": {"maxAttempts": 0}}
}
