{
  "type": "condition.timeWindow", "typeVersion": 1, "category": "condition",
  "name": "시간 조건", "description": "측정 시각이 요일·시각 범위 안이면 true, 밖이면 false(조직 시간대)", "icon": "clock",
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "days": {"type": "array", "items": {"type": "string", "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]}},
      "from": {"type": "string", "pattern": "^\\d{2}:\\d{2}$", "default": "09:00"},
      "to": {"type": "string", "pattern": "^\\d{2}:\\d{2}$", "default": "18:00"},
      "timezone": {"type": "string", "default": "Asia/Seoul"},
      "invert": {"type": "boolean", "default": false, "description": "범위 밖이면 true(운영 시간 외)"}
    }
  },
  "inputs": [{"name": "in", "type": "message"}],
  "outputs": [{"name": "true", "type": "message"}, {"name": "false", "type": "message"}, {"name": "error", "type": "error"}],
  "statePolicy": {"days": "KEEP", "from": "KEEP", "to": "KEEP", "timezone": "KEEP", "invert": "KEEP", "spaceSchedule": "KEEP"},
  "permissions": [],
  "defaults": {"retry": {"maxAttempts": 0}}
}
